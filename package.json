{
  "name": "unichat",
  "version": "0.1.0",
  "description": "Tous vos chats IA dans une seule interface — desktop (Electron) et Android (Capacitor).",
  "main": "src/main/main.js",
  "author": "Hugo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "dist:mac:zip": "electron-builder --mac zip --arm64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:all": "electron-builder --linux AppImage --x64 && electron-builder --win nsis --x64 && electron-builder --mac zip --arm64"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hugo.unichat",
    "productName": "UniChat",
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Network;InstantMessaging"
    }
  },
  "allowScripts": {
    "electron@30.5.1": true
  }
}
